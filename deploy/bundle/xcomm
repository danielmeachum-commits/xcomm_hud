#!/usr/bin/env bash
#
# xcomm — run xcomm_hud as a standalone, offline host.
#
# One host runs the stack; every other machine on the local network opens it
# in a browser. Nothing here needs the internet except `build` (and, later,
# `update`), which you run when the host is on a connected network.
#
#   xcomm init            first run: secrets, port 80, load saved images
#   xcomm build           build the app images (needs internet)
#   xcomm start | stop | restart
#   xcomm status          containers, health, URLs, running version
#   xcomm logs [service]  follow logs (api, webui, postgres, minio)
#   xcomm save-images     write every image to .bundle/images/ for offline use
#   xcomm load-images [file]
#   xcomm enable-boot | disable-boot   start the stack when the machine boots
#   xcomm allow-port-80   let rootless Podman serve on port 80 (uses sudo)
#   xcomm admin-password  print the initial admin login
#
# The web port is 80. XCOMM_WEB_PORT overrides it for one command — meant for
# testing beside a dev stack, not for normal use.
#
set -euo pipefail

BUNDLE_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_ROOT="$(cd "$BUNDLE_DIR/../.." && pwd)"
STATE_DIR="$REPO_ROOT/.bundle"
IMAGES_DIR="$STATE_DIR/images"
ENV_FILE="$STATE_DIR/xcomm.env"
COMPOSE_FILE="$BUNDLE_DIR/compose.prod.yml"
PROJECT=xcomm-hud
WEB_PORT="${XCOMM_WEB_PORT:-80}"

API_IMAGE=localhost/xcomm-hud-api
WEBUI_IMAGE=localhost/xcomm-hud-webui
MINIO_IMAGE=localhost/xcomm-hud-minio
# Chainguard only publishes :latest for free, so MinIO is pinned by digest and
# retagged under a local name (a digest reference doesn't survive save/load).
MINIO_PIN=cgr.dev/chainguard/minio@sha256:e70b2b1e74d79457f808710483bd726ff364529ca30736eaa15a6ab547d3a5a7

# Everything the stack runs, read from the compose file.
all_images() {
  grep -E '^\s+image:\s' "$COMPOSE_FILE" | awk '{print $2}'
}
# Upstream images `build` pulls: tag-pinned ones straight from the compose
# file, plus the digest-pinned MinIO.
upstream_images() {
  all_images | grep -v '^localhost/'
  echo "$MINIO_PIN"
}

# ---------- output ----------
if [[ -t 1 ]]; then
  B=$'\e[1m'; G=$'\e[32m'; Y=$'\e[33m'; R=$'\e[31m'; D=$'\e[2m'; N=$'\e[0m'
else
  B=; G=; Y=; R=; D=; N=
fi
ok()   { echo "${G}✓${N} $*"; }
info() { echo "${D}…${N} $*"; }
warn() { echo "${Y}!${N} $*" >&2; }
die()  { echo "${R}✗${N} $*" >&2; exit 1; }

# ---------- engine + compose ----------
if command -v podman >/dev/null; then
  ENGINE=podman
elif command -v docker >/dev/null; then
  ENGINE=docker
else
  die "Neither podman nor docker is installed."
fi

compose() {
  local cmd
  if [[ $ENGINE == podman ]] && command -v podman-compose >/dev/null; then
    cmd=(podman-compose)
  elif $ENGINE compose version >/dev/null 2>&1; then
    cmd=("$ENGINE" compose)
  elif command -v docker-compose >/dev/null; then
    cmd=(docker-compose)
  else
    die "No compose tool found — install podman-compose (or docker compose)."
  fi
  XCOMM_ENV_FILE="$ENV_FILE" XCOMM_WEB_PORT="$WEB_PORT" \
    "${cmd[@]}" -p "$PROJECT" -f "$COMPOSE_FILE" "$@"
}

rootless() {
  [[ $ENGINE == podman ]] && [[ "$(podman info --format '{{.Host.Security.Rootless}}')" == true ]]
}

have_image() { $ENGINE image exists "$1" 2>/dev/null || $ENGINE image inspect "$1" >/dev/null 2>&1; }

missing_images() {
  local img
  while read -r img; do
    have_image "$img" || echo "$img"
  done < <(all_images)
}

# The commit the app images are built from, "-dirty" if the tree had edits.
source_revision() {
  local sha
  sha="$(git -C "$REPO_ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)"
  if [[ -n "$(git -C "$REPO_ROOT" status --porcelain 2>/dev/null)" ]]; then
    sha="$sha-dirty"
  fi
  echo "$sha"
}

running_revision() {
  $ENGINE image inspect --format \
    '{{ index .Labels "org.opencontainers.image.revision" }}' \
    "$API_IMAGE:current" 2>/dev/null || echo "unknown"
}

# ---------- port 80 ----------
unprivileged_start() { sysctl -n net.ipv4.ip_unprivileged_port_start 2>/dev/null || echo 1024; }

port_ok() {
  # Root and Docker bind low ports themselves; only rootless Podman needs the
  # kernel to allow it.
  (( WEB_PORT >= 1024 )) && return 0
  rootless || return 0
  (( "$(unprivileged_start)" <= WEB_PORT ))
}

require_port() {
  port_ok && return 0
  die "Rootless Podman can't use port $WEB_PORT yet (the kernel only allows
  ports from $(unprivileged_start) up). Run once:  $0 allow-port-80"
}

cmd_allow_port_80() {
  if (( "$(unprivileged_start)" <= 80 )); then
    ok "Port 80 is already allowed."
    return
  fi
  info "Allowing unprivileged services to use ports 80 and up (needs sudo)…"
  # Persisted under sysctl.d so it survives a reboot, then applied now.
  echo "net.ipv4.ip_unprivileged_port_start=80" |
    sudo tee /etc/sysctl.d/90-xcomm-hud.conf >/dev/null
  sudo sysctl -q --load /etc/sysctl.d/90-xcomm-hud.conf
  ok "Port 80 allowed (saved in /etc/sysctl.d/90-xcomm-hud.conf)."
}

# ---------- addresses ----------
lan_ips() {
  if command -v ip >/dev/null; then
    ip -4 -o addr show scope global 2>/dev/null |
      awk '{print $4}' | cut -d/ -f1 | grep -v '^10\.89\.' || true
  else
    hostname -I 2>/dev/null | tr ' ' '\n' | grep -E '^[0-9.]+$' || true
  fi
}

url_for() {
  if (( WEB_PORT == 80 )); then echo "http://$1"; else echo "http://$1:$WEB_PORT"; fi
}

print_urls() {
  local ip any=0
  echo "  ${B}On this machine:${N}  $(url_for localhost)"
  while read -r ip; do
    [[ -z $ip ]] && continue
    any=1
    echo "  ${B}From other machines:${N}  $(url_for "$ip")"
  done < <(lan_ips)
  (( any )) || echo "  ${D}(no network connection — only this machine can reach it)${N}"
}

# ---------- commands ----------
cmd_init() {
  mkdir -p "$STATE_DIR" "$IMAGES_DIR"
  chmod 700 "$STATE_DIR"
  "$REPO_ROOT/scripts/gen-env.sh" "$ENV_FILE" --prod

  if ! port_ok; then
    cmd_allow_port_80
  else
    ok "Port $WEB_PORT is usable."
  fi

  local missing
  missing="$(missing_images)"
  if [[ -n $missing ]]; then
    if compgen -G "$IMAGES_DIR/xcomm-*.tar" >/dev/null; then
      cmd_load_images
    else
      warn "These images aren't on this machine yet:"
      sed 's/^/    /' <<<"$missing" >&2
      warn "With internet: run '$0 build'. Offline: copy a saved images file into"
      warn "$IMAGES_DIR/ and run '$0 load-images'."
      return 1
    fi
  fi
  ok "Images ready."
  echo
  cmd_admin_password
  echo
  echo "Next: ${B}$0 start${N}  (and ${B}$0 enable-boot${N} to start it at boot)"
}

cmd_build() {
  local rev
  rev="$(source_revision)"
  [[ $rev == *-dirty ]] &&
    warn "The checkout has uncommitted changes; the images will be labelled $rev."
  info "Pulling pinned upstream images…"
  local img
  while read -r img; do
    $ENGINE pull -q "$img" >/dev/null
  done < <(upstream_images)
  $ENGINE tag "$MINIO_PIN" "$MINIO_IMAGE:current"
  for part in api webui; do
    local repo="$API_IMAGE"
    [[ $part == webui ]] && repo="$WEBUI_IMAGE"
    info "Building $part ($rev)…"
    $ENGINE build --target prod \
      --label "org.opencontainers.image.revision=$rev" \
      -t "$repo:$rev" -t "$repo:current" \
      "$REPO_ROOT/$part"
  done
  ok "Built $rev. Run '$0 save-images' to keep a copy for offline reinstalls."
}

cmd_start() {
  [[ -f $ENV_FILE ]] || die "Not set up yet — run '$0 init' first."
  require_port
  local missing
  missing="$(missing_images)"
  [[ -z $missing ]] || die "Missing images (run '$0 load-images' or '$0 build'):
$missing"
  info "Starting xcomm_hud…"
  # podman-compose narrates every command it runs; keep that in a log and
  # only show it when something actually went wrong.
  local log="$STATE_DIR/compose.log"
  if ! compose up -d >"$log" 2>&1; then
    tail -20 "$log" >&2
    die "Couldn't start the containers (full output: $log)."
  fi
  wait_healthy || {
    warn "Still not answering after 3 minutes. Recent API logs:"
    compose logs --tail 30 api >&2 || true
    exit 1
  }
  ok "xcomm_hud is up ($(running_revision))."
  print_urls
}

# Through the web UI, so a pass means the whole chain answers:
# browser → webui → api → postgres.
wait_healthy() {
  local i
  for i in $(seq 1 90); do
    # -s without -S: a 500 while the API is still migrating is expected, and
    # printing it would read as a failure.
    if curl -fs -o /dev/null --max-time 3 "http://127.0.0.1:$WEB_PORT/api/be/healthz"; then
      return 0
    fi
    sleep 2
  done
  return 1
}

cmd_stop() {
  info "Stopping xcomm_hud (data is kept)…"
  compose down >"$STATE_DIR/compose.log" 2>&1 ||
    die "Couldn't stop cleanly (see $STATE_DIR/compose.log)."
  ok "Stopped."
}

cmd_status() {
  echo "${B}xcomm_hud${N}  version $(running_revision)  ·  engine $ENGINE"
  local rows
  rows="$($ENGINE ps -a --filter "label=com.docker.compose.project=$PROJECT" \
    --format '{{.Names}}\t{{.Status}}' 2>/dev/null || true)"
  if [[ -z $rows ]]; then
    echo "  not running — '$0 start'"
    return 0
  fi
  column -t -s $'\t' <<<"$rows" | sed 's/^/  /'
  if curl -fs -o /dev/null --max-time 3 "http://127.0.0.1:$WEB_PORT/api/be/healthz"; then
    ok "Answering on port $WEB_PORT."
    print_urls
  else
    warn "Not answering on port $WEB_PORT yet."
  fi
}

cmd_logs() { compose logs -f --tail 100 "$@"; }

cmd_save_images() {
  mkdir -p "$IMAGES_DIR"
  local missing
  missing="$(missing_images)"
  [[ -z $missing ]] || die "Can't save — these aren't on this machine:
$missing"
  local rev out tmp
  rev="$(running_revision)"
  out="$IMAGES_DIR/xcomm-$rev.tar"
  tmp="$out.partial"
  info "Saving $(all_images | wc -l) images to $out…"
  mapfile -t imgs < <(all_images)
  if [[ $ENGINE == podman ]]; then
    podman save -q -m --format docker-archive -o "$tmp" "${imgs[@]}"
  else
    docker save -o "$tmp" "${imgs[@]}"
  fi
  mv "$tmp" "$out"
  # Keep this one and the one before it, so a bad update still has a way back.
  ls -1t "$IMAGES_DIR"/xcomm-*.tar | tail -n +3 | xargs -r rm -f
  ok "Saved $(du -h "$out" | cut -f1) → $out"
}

cmd_load_images() {
  local file="${1:-}"
  if [[ -z $file ]]; then
    file="$(ls -1t "$IMAGES_DIR"/xcomm-*.tar 2>/dev/null | head -1 || true)"
    [[ -n $file ]] || die "No saved images in $IMAGES_DIR/."
  fi
  info "Loading images from $file…"
  $ENGINE load -q -i "$file" >/dev/null
  ok "Loaded $(basename "$file")."
}

UNIT_NAME=xcomm-hud.service

cmd_enable_boot() {
  local unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
  mkdir -p "$unit_dir"
  cat >"$unit_dir/$UNIT_NAME" <<EOF
[Unit]
Description=xcomm_hud offline host
# No network-online dependency: the host is often fully offline, and the stack
# only needs its own internal container network.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=$BUNDLE_DIR/xcomm start
ExecStop=$BUNDLE_DIR/xcomm stop
TimeoutStartSec=600

[Install]
WantedBy=default.target
EOF
  systemctl --user daemon-reload
  systemctl --user enable "$UNIT_NAME" >/dev/null
  # Without lingering, user services only run while someone is logged in —
  # the host has to come up on its own after a reboot.
  if [[ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" != yes ]]; then
    loginctl enable-linger "$USER" 2>/dev/null || sudo loginctl enable-linger "$USER"
  fi
  ok "xcomm_hud will start at boot (systemd user unit $UNIT_NAME)."
}

cmd_disable_boot() {
  systemctl --user disable "$UNIT_NAME" >/dev/null 2>&1 || true
  rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$UNIT_NAME"
  systemctl --user daemon-reload
  ok "xcomm_hud will no longer start at boot."
}

cmd_admin_password() {
  [[ -f $ENV_FILE ]] || die "Not set up yet — run '$0 init' first."
  local user pass
  user="$(grep '^XCOMM_HUD_INITIAL_ADMIN_USER=' "$ENV_FILE" | cut -d= -f2-)"
  pass="$(grep '^XCOMM_HUD_INITIAL_ADMIN_PASSWORD=' "$ENV_FILE" | cut -d= -f2-)"
  echo "${B}Initial admin login${N}  (only used until the first account exists)"
  echo "  username: $user"
  echo "  password: $pass"
}

usage() { sed -n '3,22p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

case "${1:-}" in
  init) cmd_init ;;
  build) cmd_build ;;
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_stop; cmd_start ;;
  status) cmd_status ;;
  logs) shift; cmd_logs "$@" ;;
  save-images) cmd_save_images ;;
  load-images) shift; cmd_load_images "$@" ;;
  enable-boot) cmd_enable_boot ;;
  disable-boot) cmd_disable_boot ;;
  allow-port-80) cmd_allow_port_80 ;;
  admin-password) cmd_admin_password ;;
  ""|-h|--help|help) usage ;;
  *) usage; exit 2 ;;
esac
