{
  "name": "cisco",
  "scopeName": "source.cisco",
  "patterns": [
    {
      "match": "^[ \\t]*!.*$",
      "name": "comment.line.exclamation.cisco"
    },
    {
      "match": "\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*'",
      "name": "string.quoted.cisco"
    },
    {
      "match": "(^[ \\t]*(?:enable[ \\t]+)?(?:password|secret)[ \\t]+(?:\\d{1,2}[ \\t]+)?)(\\S+)",
      "captures": {
        "1": {
          "name": "keyword.other.cisco"
        },
        "2": {
          "name": "constant.character.escape.secret.cisco"
        }
      }
    },
    {
      "match": "(^[ \\t]*username[ \\t]+\\S+[ \\t]+(?:[^\\n]*?[ \\t]+)?(?:password|secret)[ \\t]+(?:\\d{1,2}[ \\t]+)?)(\\S+)",
      "captures": {
        "1": {
          "name": "keyword.other.cisco"
        },
        "2": {
          "name": "constant.character.escape.secret.cisco"
        }
      }
    },
    {
      "match": "(^[ \\t]*snmp-server[ \\t]+community[ \\t]+)(\\S+)",
      "captures": {
        "1": {
          "name": "keyword.other.cisco"
        },
        "2": {
          "name": "constant.character.escape.secret.cisco"
        }
      }
    },
    {
      "match": "(^[ \\t]*crypto[ \\t]+isakmp[ \\t]+key[ \\t]+)(\\S+)",
      "captures": {
        "1": {
          "name": "keyword.other.cisco"
        },
        "2": {
          "name": "constant.character.escape.secret.cisco"
        }
      }
    },
    {
      "match": "(^[ \\t]*pre-shared-key[ \\t]+(?:local[ \\t]+|remote[ \\t]+)?)(\\S+)",
      "captures": {
        "1": {
          "name": "keyword.other.cisco"
        },
        "2": {
          "name": "constant.character.escape.secret.cisco"
        }
      }
    },
    {
      "match": "(^[ \\t]*key-string[ \\t]+(?:\\d{1,2}[ \\t]+)?)(\\S+)",
      "captures": {
        "1": {
          "name": "keyword.other.cisco"
        },
        "2": {
          "name": "constant.character.escape.secret.cisco"
        }
      }
    },
    {
      "match": "(^[ \\t]*key[ \\t]+(?:0|7)[ \\t]+)(\\S+)",
      "captures": {
        "1": {
          "name": "keyword.other.cisco"
        },
        "2": {
          "name": "constant.character.escape.secret.cisco"
        }
      }
    },
    {
      "match": "(^[ \\t]*ntp[ \\t]+authentication-key[ \\t]+\\d+[ \\t]+\\w+[ \\t]+)(\\S+)",
